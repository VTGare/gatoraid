# GatorAid reads GATORAID_* variables first and falls back to config.json
# (or the file named by GATORAID_CONFIG) for anything unset.
# `task run` loads this file as .env.

GATORAID_DISCORD_TOKEN=
# Comma-separated
GATORAID_DISCORD_OWNER_IDS=
# Register commands to one guild for development; leave empty in production
GATORAID_DISCORD_DEV_GUILD_ID=
# Receives guild join/leave notices
GATORAID_DISCORD_LOG_CHANNEL_ID=

GATORAID_DATABASE_PATH=gatoraid.db

GATORAID_HOLODEX_API_KEY=
GATORAID_HOLODEX_TLDEX=false

# Free API keys end in :fx
GATORAID_DEEPL_API_KEY=
GATORAID_DEEPL_MONTHLY_CHARACTER_BUDGET=500000

# debug, info, warn or error / json or text
GATORAID_LOG_LEVEL=info
GATORAID_LOG_FORMAT=text

# key=emoji pairs, comma-separated; replaces config.json's map entirely
# GATORAID_EMOJIS=deepl=<:deepL:123>,youtube=<:YouTube:456>
